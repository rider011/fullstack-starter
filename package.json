{
  "name": "fullstack-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,green \"npm run dev:web\" \"npm run dev:api\"",
    "dev:web": "npm run dev --workspace @fullstack/web",
    "dev:api": "npm run start:dev --workspace @fullstack/api",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspace @fullstack/api && npm run test:unit --workspace @fullstack/web",
    "test:e2e": "npm run test:e2e --workspace @fullstack/api",
    "lint": "npm run lint --workspaces --if-present",
    "format": "npm run format --workspaces --if-present",
    "db:generate": "npm run db:generate --workspace @fullstack/api",
    "db:migrate": "npm run db:migrate --workspace @fullstack/api"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
